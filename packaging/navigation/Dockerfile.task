FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive
COPY configure_apt_mirrors.py /tmp/configure_apt_mirrors.py
RUN python3 /tmp/configure_apt_mirrors.py \
    && rm /tmp/configure_apt_mirrors.py \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config patchelf dpkg-dev python3-colcon-common-extensions \
    libyaml-cpp-dev libjsoncpp-dev nlohmann-json3-dev libcurl4-openssl-dev libtinyxml2-dev libopencv-dev \
    python3-yaml python3-numpy python3-paho-mqtt python3-boto3 python3-requests python3-serial \
    ros-jazzy-cv-bridge ros-jazzy-control-msgs ros-jazzy-nav2-msgs \
    ros-jazzy-rmw-cyclonedds-cpp ros-jazzy-rosidl-default-generators \
    ffmpeg alsa-utils \
    && rm -rf /var/lib/apt/lists/*

ENV ROS_DISTRO=jazzy
ENTRYPOINT []
